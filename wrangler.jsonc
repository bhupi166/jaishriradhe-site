{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaishriradhe-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "CHANT_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
